FROM golang:1.22-alpine AS builder

ARG SERVICE_NAME

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN test -n "${SERVICE_NAME}" && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/service ./cmd/${SERVICE_NAME}

FROM alpine:3.20

WORKDIR /app

COPY --from=builder /out/service /app/service
COPY configs /app/configs

ENV CONFIG_DIR=/app/configs

ENTRYPOINT ["/app/service"]
